{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake --preset debug"
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake --build --preset build-debug"
    },
    {
      "label": "cmake: test",
      "type": "shell",
      "command": "ctest --preset test-debug --output-on-failure",
      "dependsOn": [
        "cmake: build"
      ]
    }
  ]
}
